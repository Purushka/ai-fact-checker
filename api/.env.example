# ===== 部署 =====
ENV=production
LOG_LEVEL=INFO
SERVICE_NAME=factcheck
WORKERS=2

# ===== 鉴权（与父项目共享密钥）=====
SHARED_SECRET=请改为长随机字符串_64位以上
ALLOWED_IPS=127.0.0.1,父项目内网 IP

# ===== LLM Provider =====
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
LLM_FALLBACK_PROVIDER=qwen
LLM_FALLBACK_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 通义千问（阿里云灵积）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 月之暗面 Moonshot
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 智谱 GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 腾讯混元（如部署在腾讯云 VPC 内网，可走内网域名）
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_REGION=ap-shanghai

# ===== Search Provider =====
SEARCH_PRIMARY=tavily
SEARCH_SECONDARY=bocha
SEARCH_FALLBACK=bing

TAVILY_API_KEY=
BOCHA_API_KEY=
SERPER_API_KEY=
BING_API_KEY=
METASO_API_KEY=

# ===== 检索行为 =====
MAX_SEARCH_CALLS_PER_CLAIM=5
MAX_FETCH_PARALLEL=8
HTTP_FETCH_TIMEOUT_SEC=8
TOTAL_TIMEOUT_SEC=30
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_POOL_SIZE=4

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HISTORICAL_SEC=2592000
CACHE_TTL_POLICY_ACTIVE_SEC=604800
CACHE_TTL_STATE_SEC=86400
CACHE_TTL_REAL_TIME_SEC=0

# ===== PostgreSQL =====
DATABASE_URL=postgresql+asyncpg://factcheck:CHANGEME@localhost:5432/factcheck
DB_POOL_SIZE=10

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 监控 =====
PROMETHEUS_PORT=9090
SENTRY_DSN=

# ===== 内容安全（公网部署可对接阿里云/腾讯云内容安全 API；私有化版用本地敏感词库）=====
CONTENT_SAFETY_ENABLED=false
CONTENT_SAFETY_PROVIDER=local
